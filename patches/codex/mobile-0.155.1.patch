+/// Feed output produced by the iOS exec hook through the same transcript and
+/// delta event boundary used by native unified exec processes.
+#[cfg(target_os = "ios")]
+#[allow(clippy::too_many_arguments)]
+pub(crate) async fn process_chunk(
+    pending: &mut Vec<u8>,
+    transcript: &Arc<Mutex<HeadTailBuffer>>,
+    call_id: &str,
+    session_ref: &Arc<Session>,
+    turn_ref: &Arc<TurnContext>,
+    emitted_deltas: &mut usize,
+    chunk: Vec<u8>,
+) {
+    transcript.lock().await.push_chunk(&chunk);
+    pending.extend_from_slice(&chunk);
+
+    while !pending.is_empty() {
+        let complete = utf8_boundary(pending);
+        if complete == 0 {
+            break;
+        }
+        let prefix: Vec<u8> = pending.drain(..complete).collect();
+        if *emitted_deltas >= MAX_EXEC_OUTPUT_DELTAS_PER_CALL {
+            continue;
+        }
+        session_ref
+            .send_event(
+                turn_ref.as_ref(),
+                EventMsg::ExecCommandOutputDelta(ExecCommandOutputDeltaEvent {
+                    call_id: call_id.to_string(),
+                    stream: ExecOutputStream::Stdout,
+                    chunk: prefix,
+                }),
+            )
+            .await;
+        *emitted_deltas += 1;
+    }
+}
