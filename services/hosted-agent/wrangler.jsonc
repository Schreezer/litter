{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnfold-hosted-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // REQUIRE_SUBSCRIPTION stays "false" until the RevenueCat products are live and
  // a build with purchases has shipped. See README.md.
  "vars": { "GUEST_BETA_ENABLED": "true", "REQUIRE_SUBSCRIPTION": "false" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HostedCourseAgent",
        "class_name": "HostedCourseAgent"
      },
      { "name": "GuestUsage", "class_name": "GuestUsage" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HostedCourseAgent"]
    },
    { "tag": "v2", "new_sqlite_classes": ["GuestUsage"] }
  ]
}
